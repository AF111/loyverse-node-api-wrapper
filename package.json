{
  "name": "loyverse-api-wrapper",
  "version": "1.0.4",
  "description": "TypeScript Node.js client for the Loyverse REST API",
  "files": [
    "dist/**/*"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "version": "npm run changelog && git add CHANGELOG.md",
    "prepare": "npm run build",
    "test": "jest",
    "prepublishOnly": "npm test -- --runInBand && npm run build",
    "changelog": "node scripts/generate-changelog.js",
    "changelog:all": "node scripts/generate-changelog.js",
    "changelog:verify": "node scripts/generate-changelog.js --check"
  },
  "keywords": [
    "loyverse",
    "api",
    "wrapper",
    "node",
    "js"
  ],
  "jest": {
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coveragePathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/src/typings/",
      "<rootDir>/src/lib/Resources/",
      "<rootDir>/src/Errors.ts"
    ],
    "coverageDirectory": "<rootDir>/coverage/",
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/src/typings/",
      "<rootDir>/src/lib/Resources/",
      "<rootDir>/src/Errors.ts"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "verbose": false
  },
  "author": "AF111",
  "repository": {
    "type": "git",
    "url": "https://github.com/AF111/loyverse-node-api-wrapper"
  },
  "license": "MIT",
  "dependencies": {
    "got": "^11.5.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.12.16",
    "@babel/preset-typescript": "^7.12.16",
    "@types/jest": "^26.0.20",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "cookie-parser": "^1.4.5",
    "dotenv": "^8.2.0",
    "ejs": "^3.1.5",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.31.0",
    "express": "^4.17.1",
    "jest": "^26.6.3",
    "lowdb": "^1.0.0",
    "morgan": "^1.10.0",
    "parcel": "^2.0.0-beta.1",
    "typescript": "^5.7.3",
    "@types/node": "^22.15.30",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "conventional-changelog": "^6.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
